# Sonicore 环境变量（开箱即用，可直接 docker compose up）
# 如需修改密码/密钥，编辑此文件后重启即可

# === JWT（必改：生产环境请用 openssl rand -hex 32 生成） ===
SONICORE_JWT_SECRET=change-me-in-production

# === 数据库 Postgres ===
POSTGRES_USER=sonicore
POSTGRES_PASSWORD=sonicore
POSTGRES_DB=sonicore

SONICORE_DATABASE_HOST=postgres
SONICORE_DATABASE_PORT=5432
SONICORE_DATABASE_USER=sonicore
SONICORE_DATABASE_PASSWORD=sonicore
SONICORE_DATABASE_DBNAME=sonicore

# === 缓存 Redis ===
SONICORE_REDIS_HOST=redis
SONICORE_REDIS_PORT=6379
SONICORE_REDIS_PASSWORD=

# === 数据目录 ===
MUSIC_DIR=/opt/sonicore/music
DATA_DIR=/opt/sonicore/data

# 可信代理 CIDR，逗号分隔。来自这些地址的请求才信任其 X-Real-IP header
# SONICORE_SERVER_TRUSTED_PROXIES=172.17.0.0/16

# === PulseAudio ===
# 主机 socket 需映射到容器 /run/pulse/native，并设置此值：
# SONICORE_AUDIO_PULSE_SERVER=/run/pulse/native

# === 外部音乐平台（默认全部关闭）===
# 启用网易云音乐（榜单/搜索/歌曲与艺人详情）
# SONICORE_PLATFORMS_NETEASE_ENABLED=true
# 可选：登录后导出的 Cookie（含 MUSIC_U/MUSIC_A），留空则使用匿名访问
# SONICORE_PLATFORMS_NETEASE_COOKIE=

# === 可选 ===
SONICORE_SERVER_PORT=4530
SONICORE_SERVER_BASE_URL=http://localhost:28880
SONICORE_LOG_LEVEL=info

